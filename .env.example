# Dedicated OAuth credentials for the standalone Code auth service.
# These are preferred over generic/shared GOOGLE_* or GITHUB_* vars.

CODE_GOOGLE_CLIENT_ID=
CODE_GOOGLE_CLIENT_SECRET=
CODE_GOOGLE_CALLBACK_URL=http://localhost:2048/api/auth/google/callback

CODE_GITHUB_CLIENT_ID=
CODE_GITHUB_CLIENT_SECRET=
CODE_GITHUB_CALLBACK_URL=http://localhost:2048/api/auth/github/callback

# Optional explicit service settings
AUTH_PORT=2040
AUTH_COOKIE_NAME=auth_sid
AUTH_SESSION_SECRET=change-me
