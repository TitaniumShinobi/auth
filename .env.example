# Example environment for a product generated from the TypeScript/Node/Express/Prisma profile.
# The product owns these values and its secret-loading mechanism. AUTH never reads or stores them.
PORT=1111
AUTH_ISSUER=http://127.0.0.1:1111
AUTH_SIGNING_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_NAME=__Host-auth_session
DATABASE_URL=file:./auth.db

# JSON objects keyed by registered client or provider identifier. Never commit real secrets.
AUTH_CLIENTS_JSON={}
AUTH_PROVIDERS_JSON={}

# Optional product-owned delivery hook used by magic-email flows.
# AUTH_MAGIC_DELIVERY_URL=https://product.example/internal/auth/magic-delivery
