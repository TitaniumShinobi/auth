# Dedicated OAuth credentials for the standalone Code auth service.
# These are preferred over generic/shared GOOGLE_* or GITHUB_* vars.

CODE_GOOGLE_CLIENT_ID=
CODE_GOOGLE_CLIENT_SECRET=
CODE_GOOGLE_CALLBACK_URL=http://localhost:2048/api/auth/google/callback

CODE_GITHUB_CLIENT_ID=
CODE_GITHUB_CLIENT_SECRET=
CODE_GITHUB_CALLBACK_URL=http://localhost:2048/api/auth/github/callback

# Optional explicit service settings
AUTH_PORT=1111
AUTH_COOKIE_NAME=auth_sid
AUTH_SESSION_SECRET=change-me

# VVAULT (run with AUTH_APP_CONFIG_PATH=config/vvault.json and e.g. AUTH_PORT=1122)
# AUTH_APP_CONFIG_PATH=config/vvault.json
# AUTH_PORT=1122
VVAULT_GOOGLE_CLIENT_ID=
VVAULT_GOOGLE_CLIENT_SECRET=
VVAULT_PUBLIC_CALLBACK_BASE=http://localhost:7784

# Optional AUTH-owned readiness integration; paths/reference digest only, never secrets.
# Missing/unproven adapter keeps /ready/auth at 503. /ready is routes-only.
# AUTH_RELIABILITY_MANIFEST=/absolute/reviewed-release-manifest.json
# AUTH_RELIABILITY_ADAPTER=/absolute/reviewed-readonly-host-adapter.mjs
# AUTH_RELIABILITY_ADAPTER_SHA256=<reviewed-lowercase-sha256>
